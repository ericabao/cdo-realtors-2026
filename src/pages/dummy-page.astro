---
import Header from "../components/Header.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Carousel from "../components/dummy/Carousel.astro";
import Card from "../components/dummy/Card.astro";
import Footer from "../components/Footer.astro";
---

<DefaultLayout title="CDO Realtors" description="Dummy Page">
  <Header />
  <main>
    <div class="max-w-7xl mx-auto px-10 md:px-0 py-10">
      <h1 class="text-4xl pb-6">
        I'm a dummy page with a content from daisyUI components. You can
        replacement me anytime you want!
      </h1>

      <Carousel />
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 p-4">
        <Card />
        <Card />
        <Card />
      </div>
    </div>
  </main>
  <Footer />
</DefaultLayout>
