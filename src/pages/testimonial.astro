---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from "astro:content";
import { Image } from 'astro:assets';
const posts = await getCollection("reviews", ({ data }) => {
  return data;
});
---

<DefaultLayout title="CDO Realtors" description="Testimonial page">
  <Header />  
  <main>
    <section
      class="px-10 py-10 mx-auto text-center md:px-0 bg-neutral-100"
    >
      <div class="py-10 text-cdoRealtorsNeutral-50">
        <p class="text-sm font-bold uppercase">Testimonials</p>
        <h2 class="text-4xl font-semibold">Take their word for it</h2>
      </div>
    </section>

      <div
        class="grid items-center justify-center grid-cols-1 md:grid-cols-4 gap-20 md:gap-x-10 md:gap-y-16 max-w-7xl mx-auto text-center py-10"
      >
       {
          posts.map((post) => ( 
            <div class="border rounded-md p-5 rounded-bl-md rounded-br-md shadow-lg flex items-center flex-col bg-primary-900 text-primary-100">

            {post.data.headshot && (
              <Image width={720} height={360} src={post.data.headshot} alt="" class="w-30 border-4 border-primary-900 rounded-full -translate-y-14" />
            )}
              <div class="-mt-14">
                <p class="py-2">{post.data.rating}</p>
                <p class="text-sm leading-6 text-left whitespace-normal">{post.data.content}</p>
                <p class="font-semibold pt-4">{post.data.name}</p>
              </div>
              </div>  
          ))
        }
      </div>
  </main>
  <Footer />
</DefaultLayout>
