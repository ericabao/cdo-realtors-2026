---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PageListingSingle from '../../layouts/PageListingSingle.astro';

export async function getStaticPaths() {
	const posts = await getCollection('listing');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'listing'>;

const post = Astro.props;
const { Content } = await render(post);
---

<PageListingSingle {...post.data}>
	<Content />
</PageListingSingle>
