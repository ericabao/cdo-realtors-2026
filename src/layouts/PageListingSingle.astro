---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import Prose from "../components/Prose.astro";

type Props = CollectionEntry<"listing">["data"];

const {
  title,
  author,
  pubDate,
  categories,
  tags,
  address,
  button,
  draft,
  featured,
  heroImage,
  heroImageAlt,
  description,
} = Astro.props;

import { SocialShare } from "astro-social-share";
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />
    <main>
      <article class="mx-auto max-w-5xl p-10">
        <div class="text-left flex flex-col pb-5 gap-2">
          <div class="hero-image">
            {
              heroImage && (
                <Image
                  width={1020}
                  height={510}
                  src={heroImage}
                  alt={heroImageAlt}
                />
              )
            }
          </div>
          <div>
            <div class="title">
              <h1 class="text-4xl py-3">{title}</h1>
              <div class="flex gap-5 flex-col">
                <p class="address">{address}</p>
                <ul class="flex gap-1 flex-wrap md:flex-row">
                  {
                    categories.map((category: unknown) => (
                      <li class="bg-primary-900 rounded-md px-2 py-1 text-neutral-50 uppercase text-xs">
                        {category}
                      </li>
                    ))
                  }
                </ul>
                <ul class="flex gap-1 flex-wrap md:flex-row pb-5">
                  {
                    tags.map((tag: unknown) => (
                      <li class="bg-neutral-300 rounded-md px-2 py-1 text-neutral-800">
                        {tag}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
            <Prose>
              <slot />
            </Prose>
          </div>

          <div class="pt-5">
            <p class="text-lg pt-5 font-semibold">Share this property:</p>
            <SocialShare
              description="Description of the page/post"
              title="Page Title"
            />
          </div>

          <div class="grid items-center justify-center p-10">
            <Button href="/listing/" variant="primary" type="button"
              ><svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 320 512"
                class="fill-neutral-100 inline-block"
                width="18"
                height="18"
                ><path
                  fill="currentColor"
                  d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 246.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z"
                ></path></svg
              > back to all Listing</Button
            >
          </div>
        </div>
      </article>
    </main>
    <Footer />

    <style>
      #description {
        font-size: 3rem;
      }
    </style>
  </body>
</html>
