---
import ProductCard from "./ProductCard.astro";
---

<section class="px-10 py-10 mx-auto md:px-0 max-w-7xl">
  <div class="text-center">
    <p class="text-sm font-bold uppercase text-cdoRealtorsBlue-600">
      Our Products
    </p>
    <h2 class="text-4xl font-semibold">
      Progressive solutions for various scenarious
    </h2>
  </div>

  <div class="grid gap-5 py-10 grid-cols-1 md:grid-cols-3">
    <ProductCard
      imagePath="/src/assets/icon-buy.svg"
      altText="Buy icon"
      title="Find the perfect agent"
      body=`Our expert agents streamline the selling process to ensure hassle-free experience.`
      href="Get Started"
    />

    <ProductCard
      imagePath="/src/assets/icon-sell.svg"
      altText="Buy icon"
      title="Selling property for cash"
      body=`Our expert agents streamline the selling process to ensure hassle-free experience.`
      href="Get Started"
    />

    <ProductCard
      imagePath="/src/assets/icon-buy-sell.svg"
      altText="Buy icon"
      title="Buying and Selling"
      body=`Our expert agents streamline the selling process to ensure hassle-free experience.`
      href="Get Started"
    />
  </div>
</section>
