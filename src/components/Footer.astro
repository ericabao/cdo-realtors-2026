---
const today = new Date();
import Button from "./Button.astro";
---

<footer class="bg-primary-900 text-neutral-50">
  <div
    class="grid grid-cols-1 md:grid-cols-3 items-start justify-start gap-10 mx-auto max-w-7xl pt-20 px-10 md:px-0"
  >
    <div>
      <h4 class="text-lg font-semibold uppercase pb-5">Buy</h4>
      <div class="grid grid-col-3 gap-5">
        <div>
          <h5 class="text-sm uppercase text-primary-400">
            Buying with an agent
          </h5>
          <ul class="leading-8">
            <li>
              <Button href="#" variant="outline" type="button"
                >Find a buyer's agent</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >What is a buyer's agent?</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >How to choose a buyer's agent?</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Questions to ask your buyer's agent</Button
              >
            </li>
          </ul>
        </div>

        <div>
          <h5 class="text-sm uppercase text-primary-400">First-time buyers</h5>
          <ul class="leading-8">
            <li>
              <Button href="#" variant="outline" type="button"
                >First-time homebuyer tips</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >First-time homebuyer programs</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >How much home can I afford?</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Discover homes for sale</Button
              >
            </li>
          </ul>
        </div>

        <div>
          <h5 class="text-sm uppercase text-primary-400">Buyer resources</h5>
          <ul class="leading-8">
            <li>
              <Button href="#" variant="outline" type="button"
                >Down payment calculator</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Closing costs calculator</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Learn how to buy before you sell</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Documents to buy a house</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Explore the Buyer Resource Center</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Rent to own center</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Foreclosure resources</Button
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div>
      <h4 class="text-lg font-semibold uppercase pb-5">Sell</h4>
      <div class="grid grid-col-3 gap-5">
        <div>
          <h5 class="text-sm uppercase text-primary-400">
            Selling with an agent
          </h5>
          <ul class="leading-8">
            <li>
              <Button href="#" variant="outline" type="button"
                >Find a listing agent</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >How to choose a listing agent</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Steps to selling a house with an agent</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Why hire a listing agent?</Button
              >
            </li>
          </ul>
        </div>

        <div>
          <h5 class="text-sm uppercase text-primary-400">
            Selling a house for cash
          </h5>
          <ul class="leading-8">
            <li>
              <Button href="#" variant="outline" type="button"
                >Get a cash offer with Simple Sale</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >How to sell a house as-is</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >How to sell your house for cash</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Steps to selling a house for cash</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Companies that buy houses for cash</Button
              >
            </li>
          </ul>
        </div>

        <div>
          <h5 class="text-sm uppercase text-primary-400">Seller resources</h5>
          <ul class="leading-8">
            <li>
              <Button href="#" variant="outline" type="button"
                >How much is my home worth?</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Best time to sell calculator</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Checklist for selling your home</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Net proceeds calculator</Button
              >
            </li>
            <li>
              <Button href="#" variant="outline" type="button"
                >Explore the Seller Resource Center</Button
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div>
      <div class="flex flex-col gap-5">
        <h4 class="text-lg font-semibold uppercase">Lenders</h4>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Why CDO Realtors?<br /><span class="text-xs"
              >Make every transaction simple, certain, and satisfying.</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Help your clients buy before they sell<br /><span class="text-xs"
              >Unlock equity for your client's home purchase with ease.</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Access low rates with CDO Realtors Ultra™<br /><span
              class="text-xs"
              >Generate instant demand for listings and help buyers save with an
              ultra-low mortgage rate.</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Simplify closing on your client's home<br /><span class="text-xs"
              >Modern title and escrow to simplify your closing.</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Download marketing materials<br /><span class="text-xs"
              >All the materials you'd need to pitch your clients.</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Get support<br /><span class="text-xs"
              >All your questions, answered.</span
            ></a
          >
        </div>
      </div>
    </div>
  </div>

  <div
    class="grid grid-cols-1 md:grid-cols-3 items-start justify-start gap-10 mx-auto max-w-7xl py-20 px-10 md:px-0"
  >
    <div>
      <div class="flex flex-col gap-5">
        <h4 class="text-lg font-semibold uppercase">Agents</h4>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Buy Before You Sell for Builders<br /><span class="text-xs"
              >Eliminate the home sale contingency with a 0% bridge loan</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Unlock your client's equity<br /><span class="text-xs"
              >Remove your client's home sale contingency and unlock their
              equity with a 0% bridge loan.</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Download marketing materials<br /><span class="text-xs"
              >All the materials you'd need to pitch your clients.</span
            ></a
          >
        </div>

        <div class="leading-4">
          <a href="/dummy-page/"
            >Schedule a demo<br /><span class="text-xs"
              >Learn more about our Buy Before You Sell program.</span
            ></a
          >
        </div>
      </div>
    </div>

    <div>
      <div class="flex flex-col gap-5">
        <h4 class="text-lg font-semibold uppercase">Buy & Sell</h4>
        <div class="leading-4">
          <a href="/dummy-page/"
            >Buy Before You Sell for Builders<br /><span class="text-xs"
              >Eliminate the home sale contingency with a 0% bridge loan</span
            ></a
          >
        </div>
        <div class="leading-4">
          <a href="/dummy-page/"
            >Buy Before You Sell for Lenders<br /><span class="text-xs"
              >Close more deals with contingent buyers</span
            ></a
          >
        </div>
        <div class="leading-4">
          <a href="/dummy-page/"
            >Buy Before You Sell for Agents<br /><span class="text-xs"
              >Unlock equity for your client's home purchase with ease</span
            ></a
          >
        </div>
        <div class="leading-4">
          <a href="/dummy-page/"
            >Buy Before You Sell for Clients<br /><span class="text-xs"
              >Move into your new home now, and sell your current home later</span
            ></a
          >
        </div>
      </div>
    </div>

    <div>
      <h4 class="text-lg font-semibold uppercase pb-5">About Us</h4>
      <ul class="leading-8">
        <li>
          <Button href="#" variant="outline" type="button">Company</Button>
        </li>
        <li>
          <Button href="/contact/" variant="outline" type="button"
            >Contact Us</Button
          >
        </li>
        <li>
          <Button href="#" variant="outline" type="button">Careers</Button>
        </li>
        <li>
          <Button href="#" variant="outline" type="button"
            >Terms & Conditions</Button
          >
        </li>
        <li>
          <Button href="#" variant="outline" type="button"
            >Privacy Policy</Button
          >
        </li>
        <li>
          <Button href="#" variant="outline" type="button">Copyrights</Button>
        </li>
      </ul>
    </div>
  </div>

  <div
    class="grid items-center text-center bg-primary-900 py-20 border-t border-neutral-50"
  >
    <div class="max-w-7xl mx-auto">
      <div class="flex justify-center items-center text-neutral-50 gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 128 128"
          class="w-12 h-12"
        >
          <g>
            <g id="Layer_1">
              <path
                d="M117.7,69.7c0,5.2-.7,10.3-2.2,15.1l-51-55.9L13.5,84.8c-1.4-4.8-2.2-9.9-2.2-15.1,0-29.4,23.8-53.2,53.2-53.2s53.2,23.8,53.2,53.2Z"
              ></path>
              <rect x="46.7" y="67.4" width="14.8" height="14.8"></rect>
              <rect x="67.4" y="67.4" width="14.8" height="14.8"></rect>
              <rect x="46.7" y="87.2" width="14.8" height="14.8"></rect>
              <rect x="67.4" y="87.2" width="14.8" height="14.8"></rect>
            </g>
          </g>
        </svg>
        <h1 class="text-2xl font-semibold uppercase text-neutral-50">
          CDO Realtors
        </h1>
      </div>
      <p class="pb-5 text-neutral-50">
        Copyright&copy; {today.getFullYear()} - All Rights Reserved
      </p>

      <div
        class="flex items-start justify-center max-w-sm gap-5 mx-auto text-cdoRealtorsNeutral-200"
      >
        <p>Follow us:</p>

        <div class="flex items-center justify-between gap-5 social-outlines">
          <a href="/dummy-page/" target="_blank">
            <span class="sr-only">Follow CDO Realtors on Meta</span>
            <svg width="24" height="24"
              ><path
                fill="currentColor"
                d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"
              ></path></svg
            >
          </a>

          <a href="/dummy-page/" target="_blank">
            <span class="sr-only">Follow CDO Realtors on Instagram</span>
            <svg aria-hidden="true" width="24" height="24"
              ><path
                fill="currentColor"
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path></svg
            >
          </a>

          <a href="/dummy-page/" target="_blank">
            <span class="sr-only">Follow CDO Realtors on Twitter</span>
            <svg
              aria-hidden="true"
              width="24px"
              height="24px"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M14.095479,10.316482L22.286354,1h-1.940718l-7.115352,8.087682L7.551414,1H1l8.589488,12.231093L1,23h1.940717  l7.509372-8.542861L16.448587,23H23L14.095479,10.316482z M11.436522,13.338465l-0.871624-1.218704l-6.924311-9.68815h2.981339  l5.58978,7.82155l0.867949,1.218704l7.26506,10.166271h-2.981339L11.436522,13.338465z"
              ></path></svg
            >
          </a>

          <a href="/dummy-page/" target="_blank">
            <span class="sr-only">Follow CDO Realtors on YouTube</span>
            <svg
              aria-hidden="true"
              height="24"
              width="24"
              viewBox="0 0 461.001 461.001"
              ><g>
                <path
                  fill="currentColor"
                  d="M365.257,67.393H95.744C42.866,67.393,0,110.259,0,163.137v134.728c0,52.878,42.866,95.744,95.744,95.744h269.513c52.878,0,95.744-42.866,95.744-95.744V163.137C461.001,110.259,418.135,67.393,365.257,67.393z M300.506,237.056l-126.06,60.123c-3.359,1.602-7.239-0.847-7.239-4.568V168.607c0-3.774,3.982-6.22,7.348-4.514l126.06,63.881C304.363,229.873,304.298,235.248,300.506,237.056z"
