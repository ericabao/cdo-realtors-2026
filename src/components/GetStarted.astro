---
import { Image } from "astro:assets";
import getStartedBanner from "../assets/get-started-banner.avif";
import Button from "./Button.astro";
---

<section
  class="px-10 py-5 md:px-0 text-neutral-50 bg-linear-to-r from-primary-900 to-primary-900"
>
  <div
    class="flex flex-col items-center justify-between gap-10 mx-auto max-w-7xl md:flex-row"
  >
    <div class="flex flex-col gap-10 text-left">
      <div>
        <h2 class="text-4xl font-semibold">Ready to get started</h2>
        <p class="pt-4">
          Answer a few quick questions to see how we can help you
        </p>
      </div>
      <div class="flex flex-col items-center justify-between gap-5 md:flex-row">
        <Button href="/#" variant="secondary" type="button">I'm buying</Button>
        <Button href="/#" variant="secondary" type="button">I'm selling</Button>
        <Button href="/#" variant="secondary" type="button"
          >I'm buying & selling</Button
        >
      </div>
      <div class="flex items-center justify-center md:justify-start">
        <div class="inline-block">
          <a href="#" class="underline">I'm a Real Estate Agent</a>
        </div>
      </div>
    </div>
    <Image src={getStartedBanner} alt=" " class="w-full md:w-1/2" />
  </div>
</section>
