---
import ListingCard from "./ListingCard.astro";
import Button from "./Button.astro";
---

<section class="px-10 pb-10 mx-auto md:px-0 max-w-7xl" data-pagefind-ignore>
  <div class="flex items-center justify-between gap-6 py-10">
    <div>
      <h3 class="text-4xl font-semibold">New Listings</h3>
      <p>Discover the latest properties in the real estate market</p>
    </div>
    <Button href="/listing/" variant="primary" type="button"
      >Explore all Listing</Button
    >
  </div>

  <ul class="grid gap-5 md:grid-cols-3 grid-cols-1">
    <ListingCard />
  </ul>
</section>
