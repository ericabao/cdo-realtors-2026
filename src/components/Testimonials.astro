---
import { getCollection } from "astro:content";
import { Image } from 'astro:assets';
const posts = await getCollection("reviews", ({ data }) => {
  return data;
});
---

<section class="px-10 py-10 mx-auto text-center md:px-0 bg-primary-900">
  <div class="py-10 text-neutral-50">
    <p class="text-sm font-bold uppercase">Testimonials</p>
    <h2 class="text-4xl font-semibold">Take their word for it</h2>
  </div>
    <div class="flex overflow-x-hidden w-fullpy-4">
        <div class="flex shrink-0 animate-marquee min-w-full gap-8 items-center whitespace-nowrap">
      {
        posts.map((post) => (
          <div class="p-5">
            <div class="border rounded-md p-10 rounded-bl-md rounded-br-md shadow-lg flex items-center flex-col w-93.75 bg-neutral-100 text-neutral-900 gap-2">
            {post.data.headshot && (
              <Image width={720} height={360} src={post.data.headshot} alt="" class="w-30 border-4 rounded-full -translate-y-14" />
            )}
              <div class="-mt-14">
                <p class="py-2">{post.data.rating}</p>
                <p class="text-sm leading-6 text-left whitespace-normal">{post.data.content}</p>

                <p class="font-semibold pt-4">{post.data.name}</p>
              </div>

            </div>

          </div>
        ))
      }
      </div>
    </div>
</section>